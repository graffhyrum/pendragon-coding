---
import { toSlug } from '../../utils/slugify';
import ContentCard from './ContentCard.astro';
import type { ContentKind } from '../../types/ContentTemplate';

interface Props {
	layoutMode: 'grid' | 'single-column';
	contentKind: ContentKind;
	content: Array<{
		title: string;
		link: Array<{ title?: string; href: string }>;
		description: string;
	}>;
	sectionTitle: string;
}

const { layoutMode, contentKind, content, sectionTitle } = Astro.props;

const listLayout = 'w-full gap-4';
const ulClasses =
	layoutMode === 'single-column'
		? `flex flex-col ${listLayout} items-stretch`
		: `grid ${listLayout} min-w-0 grid-cols-[repeat(auto-fill,minmax(min(var(--content-card-min),100%),1fr))]`;

---

<ul class={ulClasses} role="list">
	{content.map((contentItem) => {
		const contentId = `${toSlug(sectionTitle)}-${toSlug(contentItem.title)}`;
		return (
			<ContentCard
				title={contentItem.title}
				links={contentItem.link}
				description={contentItem.description}
				layoutMode={layoutMode}
				contentKind={contentKind}
				contentId={contentId}
			/>
		);
	})}
</ul>
