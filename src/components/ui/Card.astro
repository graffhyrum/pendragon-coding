---
import type { CardVariant } from '../../types/Card';

interface Props {
	variant?: CardVariant;
	maxWidth?: string;
	minWidth?: string;
	className?: string;
	gridCell?: boolean;
	[key: string]: unknown;
}

const {
	variant = 'short-form',
	maxWidth = '',
	minWidth = '',
	className = '',
	gridCell = false,
	...rest
} = Astro.props;

const fillsCell = variant === 'long-form' || gridCell;
const chromeClasses = [
	'card-chrome',
	gridCell ? 'card-chrome--grid-cell' : 'card-chrome--inset',
	fillsCell ? 'max-w-full' : 'min-w-[min(var(--content-card-min),100%)] max-w-full',
].join(' ');

const sizeStyle = minWidth ? `min-width: ${minWidth};` : undefined;
---
<li
	class={`${chromeClasses} ${maxWidth} ${className}`}
	style={sizeStyle}
	{...rest}
>
	<slot/>
</li>
