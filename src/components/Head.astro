---
import { SITE_CONFIG, type PageMetaProps } from '../config/site';
import { buildHeadInlineScript } from '../scripts/theme-init';

type Props = PageMetaProps;

const themeInitScript = buildHeadInlineScript();

const {
	pageTitle,
	description = SITE_CONFIG.description,
	ogType = 'website',
	canonicalUrl,
} = Astro.props;
---

<head>
    <title>{pageTitle} | {SITE_CONFIG.title}</title>
    <meta charset="utf-8"/>
    <meta name="description" content={description}/>
    <meta property="og:title" content={pageTitle}/>
    <meta property="og:description" content={description}/>
    <meta property="og:type" content={ogType}/>
    {canonicalUrl && <meta property="og:url" content={canonicalUrl}/>}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl}/>}
    <link rel="icon" type="image/ico" href="/favicon_io/favicon.ico"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto&display=swap" rel="stylesheet">
    <meta name="generator" content={Astro.generator}/>
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon_io/apple-touch-icon.webp">
    <link rel="icon" sizes="32x32" href="/favicon_io/favicon-32x32.webp">
    <link rel="icon" sizes="16x16" href="/favicon_io/favicon-16x16.webp">
    <link rel="manifest" href="/favicon_io/site.webmanifest">

    <!-- Theme initialization script - runs before page render to prevent flash -->
    <script is:inline set:html={themeInitScript}></script>
</head>
