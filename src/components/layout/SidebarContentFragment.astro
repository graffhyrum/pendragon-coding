---
import Sidebar from '../navigation/Sidebar.astro';
import type { SidebarSections } from '../../types/sidebarSections';

interface Props {
	sections: SidebarSections;
	hxHistory?: boolean;
}

const { sections, hxHistory = true } = Astro.props;
---

<div class="content-layout">
	<Sidebar sections={sections} />
	<div class="main-content" hx-history={hxHistory ? undefined : 'false'}>
		<slot />
	</div>
</div>
