---
import { getCollection } from 'astro:content';
import { BLOG_LISTING_DESCRIPTION } from '../content/blogListing';
import CollectionPageLayout from '../layouts/CollectionPageLayout.astro';

const pageTitle = 'Blog';
const allBlogs = (await getCollection('blog')).toSorted(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<CollectionPageLayout
	pageTitle={pageTitle}
	description={BLOG_LISTING_DESCRIPTION}
	items={allBlogs}
/>
