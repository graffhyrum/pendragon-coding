---
import { getCollection } from 'astro:content';
import BlogListingContent from '../../components/blog/BlogListingContent.astro';
import { BLOG_LISTING_DESCRIPTION } from '../../content/blogListing';
import ApiContentWithSidebarLayout from '../../layouts/ApiContentWithSidebarLayout.astro';
import { buildBlogSidebarSections } from '../../utils/blogSidebar';

const allBlogs = (await getCollection('blog')).toSorted(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---
<ApiContentWithSidebarLayout
	sections={buildBlogSidebarSections(allBlogs)}
	hxHistory={false}
>
	<BlogListingContent description={BLOG_LISTING_DESCRIPTION} items={allBlogs} />
</ApiContentWithSidebarLayout>
