---
import type { CollectionEntry } from 'astro:content';
import BlogListingContent from '../components/blog/BlogListingContent.astro';
import Sidebar from '../components/navigation/Sidebar.astro';
import { buildBlogSidebarSections } from '../utils/blogSidebar';
import BaseLayout from './BaseLayout.astro';

interface Props {
	pageTitle: string;
	description: string;
	items: CollectionEntry<'blog'>[];
}

const { pageTitle, description, items } = Astro.props;
const blogSections = buildBlogSidebarSections(items);
---
<BaseLayout pageTitle={pageTitle}>
	<div class="content-layout">
		<Sidebar sections={blogSections} />
		<div class="main-content" hx-history="false">
			<BlogListingContent pageTitle={pageTitle} description={description} items={items} />
		</div>
	</div>
</BaseLayout>

<script>
	import { initTagFilter } from '../scripts/tag-filter';
	import { initBlogSort } from '../scripts/blog-sort';
	initTagFilter();
	initBlogSort();
</script>
