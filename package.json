		"@changesets/cli": "^2.31.1",
		"@happy-dom/global-registrator": "^20.11.2",
		"@playwright/test": "^1.62.1",
		"@types/bun": "^1.3.14",
		"@typescript/native-preview": "^7.0.0-dev.20260707.2",
		"astro": "^7.2.1",
		"caniuse-lite": "^1.0.30001809",
		"happy-dom": "^20.11.2",
		"oxfmt": "0.43.0",
		"oxlint": "1.58.0",
		"portless": "^0.13.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3"
	},
	"overrides": {
		"ajv": ">=8.20.0",
		"defu": ">=6.1.5",
